    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.2.4",
    "jspdf": "^4.2.1",
