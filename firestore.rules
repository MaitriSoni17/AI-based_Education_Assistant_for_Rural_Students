rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{mobile} {
      allow read, write: if true;
    }
    match /certificates/{certId} {
      allow read, write: if true;
    }
    match /curriculum_folders/{folderId} {
      allow read, write: if true;
    }
    match /curriculum_files/{fileId} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
  }
}
